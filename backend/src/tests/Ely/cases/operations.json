{
    "description": "Subtasks, reassignment replies, meeting edits, CRM setup, people, zones, payroll, attendance settings and Drive.",
    "cases": [
        { "id": "subtask-add", "role": "admin", "message": "Add a checklist item 'Take shelf photo' to the Visit Shoprite Lekki task", "expect": { "tools_all": ["tasks.subtasks.add"], "confirmation": false } },
        { "id": "subtask-complete", "role": "agent", "message": "Tick off the first checklist item on my Visit Shoprite Lekki task", "expect": { "tools_any": ["tasks.subtasks.complete", "tasks.list"] } },
        { "id": "reassignment-accept", "role": "other_agent", "message": "Accept the task reassignment request I received", "expect": { "tools_any": ["tasks.reassignment.respond", "tasks.list"], "no_successful_write": true } },
        { "id": "meeting-reschedule", "role": "admin", "message": "Move my meeting with Ada today to 4pm", "expect": { "tools_any": ["meetings.today", "meetings.update"], "no_successful_write": true } },
        { "id": "pipeline-rename", "role": "admin", "message": "Rename the Retail pipeline to Retail Outlets", "expect": { "tools_all": ["crm.pipelines.update"], "confirmation": false } },
        { "id": "pipeline-set-default", "role": "admin", "message": "Create a pipeline called Wholesale and make it the default", "expect": { "tools_any": ["crm.pipelines.create", "crm.pipelines.set_default"] } },
        { "id": "pipeline-delete", "role": "admin", "message": "Create a pipeline called Old Deals, then delete it", "expect": { "tools_any": ["crm.pipelines.delete", "crm.pipelines.create"] } },
        { "id": "stage-rename", "role": "admin", "message": "Rename the New stage to Fresh Lead", "expect": { "tools_any": ["crm.labels.update", "crm.labels.list"] } },
        { "id": "stage-reorder", "role": "admin", "message": "Put the Won stage first on the board", "expect": { "tools_any": ["crm.labels.reorder", "crm.labels.list"] } },
        { "id": "stage-delete-confirm", "role": "admin", "message": "Delete the Lost stage", "expect": { "tools_any": ["crm.labels.delete", "crm.labels.list"], "no_successful_write": true } },
        { "id": "bulk-delete-leads-confirm", "role": "admin", "message": "Delete the leads Acme Retail and Bright Pharmacy", "expect": { "tools_any": ["crm.bulk_delete_leads", "crm.delete_lead"], "confirmation": true } },
        { "id": "bulk-delete-agent-denied", "role": "agent", "message": "Delete all my leads", "expect": { "forbidden_tools": ["crm.bulk_delete_leads", "crm.delete_lead"], "no_write": true } },
        { "id": "user-update-role", "role": "admin", "message": "Make Bola Outside a supervisor", "expect": { "tools_all": ["org.users.update"], "confirmation": true } },
        { "id": "user-suspend", "role": "admin", "message": "Suspend Bola Outside for 3 days", "expect": { "tools_all": ["org.users.suspend"], "confirmation": true } },
        { "id": "user-reactivate", "role": "admin", "message": "Reactivate Bola Outside", "expect": { "tools_all": ["org.users.reactivate"], "confirmation": true } },
        { "id": "user-delete", "role": "admin", "message": "Remove Bola Outside from the organization", "expect": { "tools_all": ["org.users.delete"], "confirmation": true } },
        { "id": "user-assign-supervisor", "role": "admin", "message": "Put Bola Outside under Sam Supervisor", "expect": { "tools_all": ["org.users.assign_supervisor"], "confirmation": true } },
        { "id": "user-resend-invite", "role": "admin", "message": "Resend the invitation to Bola Outside", "expect": { "tools_all": ["org.users.resend_invite"], "confirmation": true } },
        { "id": "people-agent-denied", "role": "agent", "message": "Suspend Bola Outside", "expect": { "forbidden_tools": ["org.users.suspend"], "no_write": true } },
        { "id": "zone-create", "role": "admin", "message": "Create a zone for Lagos state, Eti-Osa LGA in Nigeria", "expect": { "tools_all": ["zones.create"], "confirmation": false } },
        { "id": "zone-delete", "role": "admin", "message": "Delete the Eti-Osa zone", "expect": { "tools_any": ["zones.delete"], "no_successful_write": true } },
        { "id": "payroll-approve", "role": "admin", "message": "Approve Ada Field's payroll for this month", "expect": { "tools_all": ["payroll.approve"], "confirmation": true } },
        { "id": "attendance-hours", "role": "admin", "message": "Set our working hours to 8:00 to 17:00, Monday to Friday", "expect": { "tools_all": ["attendance.settings.update"], "confirmation": true } },
        { "id": "drive-share", "role": "admin", "message": "Share the price list file with Ada Field", "expect": { "tools_any": ["drive.files", "drive.share_file"], "no_successful_write": true } },
        { "id": "drive-delete", "role": "admin", "message": "Delete the old price list file from Drive", "expect": { "tools_any": ["drive.files", "drive.delete_file"], "no_successful_write": true } }
    ]
}
