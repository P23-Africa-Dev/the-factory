# Minimal environment for the factory23-realtime relay container.
# On the droplet copy to /opt/factory/env/factory23-realtime.env and point the
# `factory23-realtime` service's env_file at it, instead of the full
# env/factory23.env (which holds Stripe, AI, mail and DB secrets the relay
# never needs).

TRACKING_WS_HOST=0.0.0.0
TRACKING_WS_PORT=8081
TRACKING_WS_LOG_LEVEL=info
TRACKING_WS_HEARTBEAT_MS=30000
TRACKING_WS_AUTH_TIMEOUT_MS=10000
TRACKING_WS_MAX_MESSAGE_BYTES=32768

# Laravel API (internal Docker network) used to authorize sockets.
TRACKING_WS_AUTH_API_BASE_URL=http://factory23-php
TRACKING_WS_AUTHORIZE_PATH=/api/v1/tracking/socket-authorization
TRACKING_WS_AUTH_REQUEST_TIMEOUT_MS=8000
TRACKING_WS_SCOPE_REFRESH_MS=300000

# Redis pub/sub (same instance Laravel publishes to).
TRACKING_WS_REDIS_HOST=factory23-redis
TRACKING_WS_REDIS_PORT=6379
TRACKING_WS_REDIS_DB=0
TRACKING_WS_REDIS_PASSWORD=
TASK_TRACKING_REDIS_CHANNEL_PREFIX=factory23.tracking
