# Copy to keystore.properties (gitignored) and fill values for a dedicated release key.
# Without this file, release builds are signed with the local Android debug keystore
# so sideload installs work. Use a real release keystore before Play Store upload.

storeFile=keystore/factory23-agent-release.jks
storePassword=REPLACE_ME
keyAlias=factory23-agent
keyPassword=REPLACE_ME
